# Client (Vite) — safe to expose; RLS protects the data
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server secrets — NEVER put real values here or in Netlify. These are Edge
# Function secrets, set via the Supabase CLI:
#
#   supabase secrets set \
#     RAZORPAY_KEY_ID=... \
#     RAZORPAY_KEY_SECRET=... \
#     RZP_WEBHOOK_SECRET=... \
#     SITE_ORIGIN=https://your-custom-domain.example
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are reserved names that Supabase
# auto-injects into every Edge Function — do not set them manually.
# ---------------------------------------------------------------------------
