# Client (Vite) — safe to expose; RLS protects the data
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server secrets — NEVER put real values here or in Netlify. They are Edge
# Function secrets on the Supabase project.
#
# The three Razorpay ones are managed by scripts/razorpay-profile.mjs. Put the
# credentials in a gitignored profile file — .razorpay/live.env, and optionally
# .razorpay/test.env — holding exactly:
#
#   RAZORPAY_KEY_ID=rzp_live_...
#   RAZORPAY_KEY_SECRET=...
#   RZP_WEBHOOK_SECRET=...
#
# then:
#
#   npm run rzp:use live     # push that profile to the project
#   npm run rzp:status       # which Razorpay account is live right now?
#
# SITE_ORIGIN is set once by hand and rarely changes:
#
#   supabase secrets set SITE_ORIGIN=https://your-custom-domain.example
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are reserved names that Supabase
# auto-injects into every Edge Function — do not set them manually.
#
# See docs/production-runbook.md for the full cutover procedure.
# ---------------------------------------------------------------------------
